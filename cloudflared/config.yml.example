
# Tunnel UUID from `cloudflared tunnel create` (SETUP.md step 5).
# Containerized cloudflared needs the UUID here, not the tunnel name,
# because no origin certificate exists inside the container.
tunnel: 00000000-0000-0000-0000-000000000000
credentials-file: /etc/cloudflared/credentials.json

ingress:
  - hostname: farsi-transcriber.jonahsaidian.com
    service: http://farsi-transcriber:8501
  - hostname: photos.jonahsaidian.com
    service: http://immich-server:2283
  - service: http_status:404
